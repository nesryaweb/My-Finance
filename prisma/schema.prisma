generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts       Account[]
  categoryGroups CategoryGroup[]
  budgets        Budget[]
  transactions   Transaction[]
  incomes        Income[]
  debts          Debt[]
  goals          FinancialGoal[]
}

model Account {
  id        String   @id @default(cuid())
  name      String
  type      String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  budgetAllocations BudgetAllocation[]
  debtPayments      DebtPayment[]
  debtReceived      DebtReceived[]
  incomeAllocations IncomeAllocation[]
  transactions      Transaction[]
  goalContributions GoalContribution[]
}

model CategoryGroup {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories Category[]

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  groupId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgetAllocations BudgetAllocation[]
  group             CategoryGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
}

model Budget {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id])
  allocations BudgetAllocation[]

  @@unique([month, year])
  @@index([userId])
}

model BudgetAllocation {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  budgetId   String
  categoryId String
  accountId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId, accountId])
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  type       String
  note       String?
  date       DateTime @default(now())
  userId     String
  accountId  String
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  debtPaymentId  String? @unique
  debtReceivedId String? @unique

  user             User              @relation(fields: [userId], references: [id])
  account          Account           @relation(fields: [accountId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  debtPayment      DebtPayment?      @relation(fields: [debtPaymentId], references: [id])
  debtReceived     DebtReceived?     @relation(fields: [debtReceivedId], references: [id])
  goalContribution GoalContribution?
}

model Income {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  date      DateTime @default(now())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id])
  allocations IncomeAllocation[]
}

model IncomeAllocation {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  incomeId  String
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  income  Income  @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@unique([incomeId, accountId])
}

model Debt {
  id             String    @id @default(cuid())
  name           String
  originalAmount Decimal   @db.Decimal(12, 2)
  minimumPayment Decimal?  @db.Decimal(12, 2)
  dueDate        DateTime?
  note           String?
  status         String    @default("ACTIVE")
  priority       Int       @default(1)
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  payments DebtPayment[]
  received DebtReceived[]
}

model DebtReceived {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  note      String?
  debtId    String
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account     Account      @relation(fields: [accountId], references: [id])
  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([debtId])
  @@index([accountId])
}

model DebtPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  note      String?
  debtId    String
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account     Account      @relation(fields: [accountId], references: [id])
  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([debtId])
  @@index([accountId])
}

model FinancialGoal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  deadline     DateTime?
  status       String    @default("ACTIVE")
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  contributions GoalContribution[]
}

model GoalContribution {
  id            String   @id @default(cuid())
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  note          String?
  goalId        String
  accountId     String
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goal        FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account     Account       @relation(fields: [accountId], references: [id])
  transaction Transaction?  @relation(fields: [transactionId], references: [id])
}
